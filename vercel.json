{
  "rewrites": [
    {
      "source": "/bodega/:path*",
      "destination": "https://storage.googleapis.com/accar-web.firebasestorage.app/:path*"
    },
    {
      "source": "/santo/:id",
      "destination": "/api/compartir?tipo=santo&id=:id"
    },
    {
      "source": "/libro/:id",
      "destination": "/api/compartir?tipo=libro&id=:id"
    },
    {
      "source": "/personaje/:id",
      "destination": "/api/compartir?tipo=personaje&id=:id"
    },
    {
      "source": "/ver/:id",
      "destination": "/api/compartir?tipo=seccion&id=:id"
    },
    {
      "source": "/vista/:path*",
      "destination": "/api/compartir?tipo=vista&id=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}